# Local Docker Compose database settings
POSTGRES_DB=payroll_db
POSTGRES_USER=payroll
POSTGRES_PORT=5434
POSTGRES_PASSWORD=payroll_secret_change_me

# Backend runtime settings
DATABASE_URL=postgres://payroll:payroll_secret_change_me@localhost:5434/payroll_db
JWT_SECRET=replace-with-at-least-32-random-characters
# Dedicated key for encrypting TOTP secrets at rest. Must not be reused from
# JWT_SECRET: the whole point is that rotating one does not disturb the other.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace-with-a-different-at-least-32-random-characters
JWT_EXPIRY_HOURS=1
RUST_LOG=info,payroll_system=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# Rate-limiting client-IP source. Leave false when the API is reachable
# directly: X-Forwarded-For is attacker-controlled there, and trusting it lets
# anyone bypass the login limiter. Set true ONLY when a trusted proxy
# (CloudFront/ALB/Caddy) is the sole path to the API — otherwise every client
# shares one bucket and a kiosk fleet rate-limits itself.
#
# Production sets this to true in deploy/docker-compose.prod.yml, because the
# container publishes 8080 on 127.0.0.1 only and the host Caddy is therefore
# the sole route in. Local dev talks to the API directly, so it stays false.
# TRUST_PROXY_HEADERS=false

# WebAuthn / passkey settings for local development
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Optional Google OAuth2 settings. Create an OAuth 2.0 "Web application"
# client in Google Cloud Console → APIs & Services → Credentials, then
# register these authorized redirect URIs:
#   http://localhost:5173/api/auth/oauth2/google/callback   (sign-in, dev)
#   http://localhost:5173/oauth2/link                       (account linking, dev)
#   https://api.payrollmy.com/api/auth/oauth2/google/callback  (sign-in, prod)
#   https://payrollmy.com/oauth2/link                          (linking, prod)
# The dev sign-in URI works because Vite proxies /api to the backend.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# API_PUBLIC_URL is the API's externally reachable origin, needed only when
# it differs from FRONTEND_URL (split-origin deploys). Empty = same origin.
# In production it is set to https://api.payrollmy.com in docker-compose.prod.yml.
# API_PUBLIC_URL=

# Optional Cloudflare Turnstile (bot protection on login, password reset,
# passkey and Google-sign-in begins). UNSET = verification skipped entirely —
# that is the intended state for local dev and CI. Set the secret in
# production (docker-compose.prod.yml passes it through); the matching site
# key goes in the frontend build env (VITE_TURNSTILE_SITE_KEY).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL is a test-only override for the siteverify endpoint;
# never set it in a real deployment.
# TURNSTILE_VERIFY_URL=

# Optional SMTP settings for password reset and letters
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Payroll System

# Optional frontend setting.
# Usually not needed in local development because Vite proxies /api to :8080.
# Add this to frontend/.env when the API is hosted on a different origin.
# VITE_API_URL=http://localhost:8080
