  "query": "UPDATE user_groups SET\n            name = COALESCE($3, name),\n            description = CASE WHEN $4::text IS NULL THEN description ELSE NULLIF($4, '') END,\n            is_active = COALESCE($5, is_active),\n            updated_by = $6,\n            updated_at = NOW()\n        WHERE id = $1 AND company_id = $2\n        RETURNING *",
