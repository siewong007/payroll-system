  "query": "SELECT id, employee_id, ot_type, hours, ot_date\n           FROM overtime_applications\n           WHERE employee_id = ANY($1)\n             AND company_id = $2\n             AND status = 'approved'\n             AND payroll_run_id IS NULL\n             AND ot_date <= $3\n           ORDER BY employee_id, ot_date, id",
