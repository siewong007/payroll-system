  "db_name": "PostgreSQL",
  "query": "UPDATE attendance_personal_qr_tokens\n           SET used = TRUE\n           WHERE token_hash = $1\n             AND company_id = $2\n             AND used = FALSE\n             AND expires_at >= NOW()\n           RETURNING id, company_id, employee_id, user_id, token_hash, action,\n                     device_id, cookie_device_id, session_id, passkey_id, user_agent,\n                     used, expires_at, created_at",
