  "query": "SELECT employee_id, ot_type, COALESCE(SUM(hours), 0::NUMERIC) AS \"hours!\"\n           FROM overtime_applications\n           WHERE employee_id = ANY($1)\n             AND ot_date >= $2 AND ot_date <= $3\n             AND status = 'approved'\n           GROUP BY employee_id, ot_type",
