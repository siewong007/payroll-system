  "db_name": "PostgreSQL",
  "query": "INSERT INTO user_totp (user_id, secret_encrypted, enabled, confirmed_at, last_used_step, failed_attempts, locked_until)\n        VALUES ($1, $2, false, NULL, NULL, 0, NULL)\n        ON CONFLICT (user_id) DO UPDATE SET\n            secret_encrypted = EXCLUDED.secret_encrypted,\n            enabled = false,\n            confirmed_at = NULL,\n            last_used_step = NULL,\n            failed_attempts = 0,\n            locked_until = NULL,\n            code_login_failed_attempts = 0,\n            code_login_locked_until = NULL,\n            updated_at = NOW()\n        WHERE user_totp.enabled = FALSE\n        RETURNING *",
