# Reference host Caddy site block for the static PWA frontend on payrollmy.com.
#
# Ensure the host Caddyfile serving /opt/payrollmy-site enforces fresh SW/HTML
# validation and proper MIME types behind Cloudflare, and never falls back to
# index.html for missing /sw.js or /assets/* paths.

payrollmy.com {
    root * /opt/payrollmy-site
    encode zstd gzip

    header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Anti-framing + full CSP emitted in HTTP response headers so static HTML,
    # offline.html, and SVGs under /branding/* inherit strong resource controls
    # (`frame-ancestors` is ignored inside <meta> CSP tags).
    header X-Frame-Options "DENY"
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com 'sha256-KZprZ5wjRXV8Aj9Zl46B4kDwZsRP6Mv6mcxNgy1tMxc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.payrollmy.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://api.payrollmy.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    header Cross-Origin-Opener-Policy "same-origin"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "camera=(self), geolocation=(self), microphone=()"

    @sw path /sw.js
    header @sw Content-Type "application/javascript; charset=utf-8"
    header @sw Cache-Control "no-cache, no-store, must-revalidate"

    @manifest path /manifest.webmanifest
    header @manifest Content-Type "application/manifest+json; charset=utf-8"
    header @manifest Cache-Control "no-cache, must-revalidate"

    @html path / /index.html /offline.html
    header @html Cache-Control "no-cache, must-revalidate"

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    handle /assets/* {
        file_server {
            hide .* *.map
        }
    }

    handle /sw.js {
        file_server {
            hide .* *.map
        }
    }

    handle /manifest.webmanifest {
        file_server {
            hide .* *.map
        }
    }

    handle /icons/* {
        file_server {
            hide .* *.map
        }
    }

    handle /branding/* {
        file_server {
            hide .* *.map
        }
    }

    handle {
        header Cache-Control "no-cache, must-revalidate"
        try_files {path} /index.html
        file_server {
            hide .* *.map
        }
    }
}
