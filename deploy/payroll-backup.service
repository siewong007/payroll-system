[Unit]
Description=Payroll nightly local database backup
Documentation=file:///opt/payroll/payroll-backup.sh
# The dump needs the database container.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/payroll/payroll-backup.sh
# Runs as root: `docker exec` into payroll-db and writes /opt/payroll/backups.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=payroll-backup
RuntimeDirectoryMode=0700
ReadWritePaths=/opt/payroll/backups /opt/payroll/logs /run/payroll-backup
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
