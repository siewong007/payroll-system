[Unit]
Description=Payroll nightly local database backup
Documentation=file:///opt/payroll/deploy/payroll-backup.sh
# The dump needs the database container.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/payroll/payroll-backup.sh
# Runs as root: `docker exec` into payroll-db and writes /opt/payroll/backups.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/payroll/backups /opt/payroll/logs
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
