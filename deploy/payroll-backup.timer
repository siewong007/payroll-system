[Unit]
Description=Payroll nightly encrypted database backup schedule

[Timer]
# 01:30 Malaysia time, after midnight rollover and well before the 12:30
# auto-absent window, with catch-up if the host was down at the moment.
OnCalendar=*-*-* 01:30:00 Asia/Kuala_Lumpur
RandomizedDelaySec=10m
Persistent=true
Unit=payroll-backup.service

[Install]
WantedBy=timers.target
